# AL PRO configuration — copy to .env and fill what you have.
ALPRO_USER_NAME=Ali
ALPRO_LOCALE=tr
ALPRO_BASE_CURRENCY=TRY

# SQLite by default; for Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/alpro

# TCMB EVDS (free key: https://evds2.tcmb.gov.tr) -> live FX rates
# EVDS_API_KEY=

# TEFAS fund codes you hold/watch (comma separated) -> live NAVs
# ALPRO_TEFAS_FUNDS=

# Optional LLM polish for the briefing (one of):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ALPRO_LLM_MODEL=

# Set to 0 to force offline (fixture) mode
ALPRO_ALLOW_NETWORK=1
ALPRO_API_TOKEN=

# --- Çok kullanıcılı çekirdek (Faz 1): e-posta + magic link, parola yok ---
# Kurucu hesabı: X-API-Key köprüsü ve eski tek-kullanıcı verisi buna bağlanır.
ALPRO_FOUNDER_EMAIL=founder@local
# Beta davet listesi (virgülle ayrılmış e-postalar). Listede olmayan giremez.
ALPRO_INVITES=
# console: magic link sunucu loguna yazılır (beta). SMTP/Resend ileride.
ALPRO_EMAIL_MODE=console
# Oturum süresi (gün) ve link geçerliliği (dakika)
ALPRO_SESSION_DAYS=30
ALPRO_LINK_MINUTES=15
